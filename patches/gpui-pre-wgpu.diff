+    /// A variable font keeps every weight in one face, so picking a face by
+    /// weight can never select its bold. Returns the `FontId` that draws
+    /// `font_id` at `weight`, which is `font_id` itself for a static font.
+    fn weight_instance(&mut self, font_id: FontId, weight: Weight) -> FontId {
+        let loaded_font = &self.loaded_fonts[font_id.0];
+        let Some(axis) = loaded_font
+            .font
+            .as_swash()
+            .variations()
+            .find_by_tag(swash::Tag::from_be_bytes(*b"wght"))
+        else {
+            return font_id;
+        };
+        let weight = Weight(f32::from(weight.0).clamp(axis.min_value(), axis.max_value()) as u16);
+        if weight == loaded_font.weight {
+            return font_id;
+        }
+        if let Some(&instance_id) = self.weight_instances.get(&(font_id, weight)) {
+            return instance_id;
+        }
+
+        let instance = LoadedFont {
+            font: Arc::clone(&loaded_font.font),
+            weight,
+            features: loaded_font.features.clone(),
+            is_known_emoji_font: loaded_font.is_known_emoji_font,
+            user_fallback_chain: Arc::clone(&loaded_font.user_fallback_chain),
+        };
+        let instance_id = FontId(self.loaded_fonts.len());
+        self.loaded_fonts.push(instance);
+        self.weight_instances.insert((font_id, weight), instance_id);
+        instance_id
+    }
